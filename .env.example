# Local development environment (safe template)
# Copy to .env and fill secrets locally.

# App URLs used by backend/frontend local stack
DATABASE_URL=postgresql://auditcare:auditcare@localhost:5433/auditcare
STATEWAVE_URL=http://localhost:8100

# Optional: override Statewave extraction behavior in backend
STATEWAVE_EPISODE_PATH=/v1/episodes
STATEWAVE_COMPILE_PATH=/v1/memories/compile
STATEWAVE_CONTEXT_PATH=/v1/context
STATEWAVE_SUBJECT_PREFIX=patient
STATEWAVE_CONTEXT_MAX_TOKENS=1800
